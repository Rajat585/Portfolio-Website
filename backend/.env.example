# Copy this file to `.env` for local development.
# In production (Render / VPS) set these as real environment variables instead.

# --- Core ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,rajatverma.dev,www.rajatverma.dev

# --- Database (MySQL) ---
# Format: mysql://USER:PASSWORD@HOST:3306/DBNAME
# Leave unset to fall back to local sqlite for quick testing.
DATABASE_URL=mysql://root:password@127.0.0.1:3306/rajat_portfolio

# --- Email (SMTP) — used by the contact form ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=rajatverma8855@gmail.com
EMAIL_PASSWORD=replace-with-a-gmail-app-password
CONTACT_RECEIVER_EMAIL=rajatverma8855@gmail.com

# --- WhatsApp automation (optional — leave blank to disable) ---
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_TO_NUMBER=+919685431574

# --- Security (set True in production, behind HTTPS) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=https://rajatverma.dev,https://www.rajatverma.dev

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://rajatverma.dev,https://www.rajatverma.dev

# --- reCAPTCHA (optional — leave blank to disable captcha check) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
